<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/listLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/listTitle"
        android:layout_width="262dp"
        android:layout_height="58dp"
        android:layout_marginStart="74dp"
        android:layout_marginTop="33dp"
        android:layout_marginEnd="75dp"
        android:layout_marginBottom="55dp"
        android:text="LIST"
        android:textAlignment="center"
        android:textSize="34sp"
        app:layout_constraintBottom_toTopOf="@+id/num777"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/num1"
        android:layout_width="88dp"
        android:layout_height="40dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="142dp"
        android:layout_marginEnd="138dp"
        android:layout_marginBottom="13dp"
        android:text="1 (1 point)"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/num2"
        app:layout_constraintEnd_toStartOf="@+id/num777"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/num2"
        android:layout_width="85dp"
        android:layout_height="37dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="136dp"
        android:layout_marginBottom="11dp"
        android:text="2 (1 point)"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/num3"
        app:layout_constraintEnd_toStartOf="@+id/num1000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/num1" />

    <TextView
        android:id="@+id/num3"
        android:layout_width="89dp"
        android:layout_height="44dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="139dp"
        android:layout_marginBottom="16dp"
        android:text="3 (1 point)"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/num5"
        app:layout_constraintEnd_toStartOf="@+id/num123"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/num2" />

    <TextView
        android:id="@+id/num10"
        android:layout_width="95dp"
        android:layout_height="31dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="103dp"
        android:layout_marginBottom="24dp"
        android:text="10 (2 points)"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/num50"
        app:layout_constraintEnd_toStartOf="@+id/num1000000"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/num5" />

    <TextView
        android:id="@+id/num50"
        android:layout_width="102dp"
        android:layout_height="38dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="117dp"
        android:layout_marginBottom="192dp"
        android:text="50 (3 points)"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/num0"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/num10" />

    <TextView
        android:id="@+id/num5"
        android:layout_width="91dp"
        android:layout_height="36dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="10dp"
        android:text="5 (2 points)"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/num3" />

    <TextView
        android:id="@+id/num777"
        android:layout_width="117dp"
        android:layout_height="34dp"
        android:layout_marginStart="138dp"
        android:layout_marginBottom="28dp"
        android:text="777 (10 points)"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/num1000"
        app:layout_constraintStart_toEndOf="@+id/num1" />

    <TextView
        android:id="@+id/num1000"
        android:layout_width="122dp"
        android:layout_height="31dp"
        android:layout_marginStart="136dp"
        android:layout_marginTop="32dp"
        android:text="1,000 (10 points)"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/num2"
        app:layout_constraintTop_toBottomOf="@+id/num777" />

    <TextView
        android:id="@+id/num123"
        android:layout_width="113dp"
        android:layout_height="37dp"
        android:layout_marginStart="132dp"
        android:layout_marginTop="24dp"
        android:text="123 (10 points)"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/num3"
        app:layout_constraintTop_toBottomOf="@+id/num1000" />

    <TextView
        android:id="@+id/num23"
        android:layout_width="105dp"
        android:layout_height="32dp"
        android:layout_marginStart="132dp"
        android:layout_marginBottom="44dp"
        android:text="23 (15 points)"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/num1000000"
        app:layout_constraintStart_toEndOf="@+id/num3" />

    <TextView
        android:id="@+id/num1000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="48dp"
        android:text="1,000,000 (50 points)"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/num0"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/num0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="120dp"
        android:layout_marginBottom="92dp"
        android:text="0 (100 points)"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/goBackfromList"
        app:layout_constraintStart_toEndOf="@+id/num50" />

    <Button
        android:id="@+id/goBackfromList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="155dp"
        android:layout_marginEnd="155dp"
        android:layout_marginBottom="93dp"
        android:backgroundTint="#FF0000"
        android:onClick="onBackClick"
        android:text="Go Back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
